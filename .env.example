# Copy this file to .env and fill in real values.
# On Render, set these as Environment Variables in the dashboard.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/dbname"

# Cloudinary — required for ad image uploads to persist.
# Get these from https://cloudinary.com (Dashboard → Account Details).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: comma-separated emails allowed to manage the blog & approve ads
# from their normal user dashboard.
BLOG_OWNER_EMAILS="riyadotpatel@gmail.com"
